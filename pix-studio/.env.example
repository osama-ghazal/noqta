# From `nqs app init` (the secret is shown once — keep it out of git).
NOQTA_CLIENT_ID=
NOQTA_CLIENT_SECRET=

# Public API (default https://apps-api.noqta.ps/v1)
# NOQTA_API_URL=

PORT=3000
# Who may frame the app. Default: the Noqta admin (https://admin.noqta.ps), plus http://localhost:*
# while developing (NODE_ENV isn't "production"). Set it only to override that (e.g. staging).
# NOQTA_ADMIN_ORIGINS=https://admin.noqta.ps

# AI (same keys as Pix): Gemini draws the images, Claude briefs the realistic scenes.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# SCENE_STUDY_MODEL=claude-opus-5-5
# SCENE_BRIEF_MODEL=claude-sonnet-5-5
