{%- comment -%}
  A product block ("target": "product"): shown on every product page once the merchant switches it on
  (the app → "In the store"). `product` is the product being viewed. The badge only appears on
  products this app regenerated: it reads the app's metafield set by server/jobs.ts.
{%- endcomment -%}
{%- assign regenerated = product | app_metafield: 'ai_images.regenerated_at' -%}
{%- if regenerated != blank -%}
  <p class="nq-ai-badge" title="{{ regenerated | escape }}">✨ {{ section.settings.label | escape }}</p>
{%- endif -%}

{% stylesheet %}
.nq-ai-badge { display: inline-flex; gap: 6px; margin: 8px 0; padding: 4px 12px; border-radius: 999px; background: #f5f5f5; color: #000; font-size: 13px; }
{% endstylesheet %}

{% schema %}
{
  "name": "شارة الصور المحسّنة",
  "target": "product",
  "settings": [
    { "type": "text", "id": "label", "label": "النص", "default": "صور محسّنة بالذكاء الاصطناعي" }
  ]
}
{% endschema %}
